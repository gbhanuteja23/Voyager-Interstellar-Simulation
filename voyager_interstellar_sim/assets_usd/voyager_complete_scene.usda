    def Xform "Environment"
    {
        def DomeLight "MilkyWayDomeLight"
        {
            float inputs:intensity = 85
            asset inputs:texture:file = @voyager_interstellar_sim/assets_usd/textures/milky_way_starfield.png@
            token inputs:texture:format = "latlong"
        }

        def DistantLight "SolarDirectionalKeyLight"
        {
            float inputs:angle = 0.53
            color3f inputs:color = (1, 0.97, 0.91)
            float inputs:intensity = 3400
            matrix4d xformOp:transform = ( (-0.2906299310344618, -0.9568355361225377, 0, 0), (-0.029726238724410017, 0.009029069661646459, 0.9995172968149899, 0), (-0.9563736685617203, 0.29048964304109215, -0.031067239459847056, 0), (0, 0, 0, 1) )
            uniform token[] xformOpOrder = ["xformOp:transform"]
        }

        def DistantLight "GalacticFillLight"
        {
            color3f inputs:color = (0.55, 0.68, 1)
            float inputs:intensity = 18
            float3 xformOp:rotateXYZ = (-55, 30, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
    }

    def Xform "SolarSystem"
    {
        def Xform "Sun"
        {
            def Mesh "Photosphere" (
                prepend apiSchemas = ["MaterialBindingAPI"]
