            float3 xformOp:scale:worldScale = (0.032, 0.032, 0.032)
            double3 xformOp:translate:worldPos = (222.54522725454316, -68.53271801979581, 6.673976553065351)
            uniform token[] xformOpOrder = ["xformOp:translate:worldPos", "xformOp:orient:worldRot", "xformOp:scale:worldScale"]

            over "SRB_Left"
            {
                float xformOp:rotateX:peel = 0
                double3 xformOp:translate:sep = (0, -3.15, -0)

                over "SRBPlume"
                {
                    float3 xformOp:scale:throttle = (1, 1, 1)
                }
            }

            over "SRB_Right"
            {
                float xformOp:rotateX:peel = -0
                double3 xformOp:translate:sep = (0, 3.15, -0)

                over "SRBPlume"
                {
                    float3 xformOp:scale:throttle = (1, 1, 1)
                }
            }

            over "CoreStage"
            {
                double3 xformOp:translate:sep = (0, 0, -0)

                over "CorePlume"
                {
                    float3 xformOp:scale:throttle = (1, 1, 1)
                }
            }

            over "CentaurStage"
            {
                over "CentaurPlume"
                {
                    float3 xformOp:scale:throttle = (0.001, 0.001, 0.001)
                }
            }

            over "Fairing_Left"
            {
                float xformOp:rotateY:peel = -0
